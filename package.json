{
  "name": "edurain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node generate_routes.cjs",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "sync-wiki": "node wiki/scripts/extract_chats.cjs",
    "push": "npm run sync-wiki && git add . && git commit -a -m \"Update site\" --allow-empty && git push && npm run deploy"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "firebase": "^12.16.0",
    "quill": "^2.0.3",
    "sharp": "^0.35.3"
  }
}
