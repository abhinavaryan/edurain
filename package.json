{
  "name": "edurain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "optimize-images": "node scripts/optimize_local_images.cjs",
    "build": "node scripts/optimize_local_images.cjs && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build && node generate_routes.cjs",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "sync-courses-s3": "node scripts/sync_courses_s3.mjs",
    "sync-blogs-s3": "node scripts/sync_blogs_s3.mjs",
    "sync-wiki": "node wiki/scripts/extract_chats.cjs",
    "push": "node scripts/optimize_local_images.cjs && npm run sync-wiki && git add . && git commit -a -m \"Update site\" --allow-empty && git push && npm run deploy"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.26",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@tailwindcss/postcss": "^4.3.3",
    "animejs": "^3.2.2",
    "cheerio": "^1.2.0",
    "firebase": "^12.16.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.38.0",
    "quill": "^2.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "sharp": "^0.35.3"
  }
}
