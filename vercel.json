{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]",
  "redirects": [
    { "source": "/study", "destination": "/webapp/", "permanent": true },
    { "source": "/study/:path*", "destination": "/webapp/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/webapp", "destination": "https://edurain-web.vercel.app/webapp/" },
    { "source": "/webapp/:path*", "destination": "https://edurain-web.vercel.app/webapp/:path*" }
  ]
}
