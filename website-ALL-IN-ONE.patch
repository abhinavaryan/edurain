] text-[#c2ebdc] min-h-screen py-10 sm:py-12\">\n      \n<!-- Central Content Stream with Emerald Connected Spine -->\n<div class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4 sm:space-y-6 relative\">\n<!-- Subtle Ambient Glow -->\n<div class=\"absolute -top-10 left-1/2 -translate-x-1/2 w-[700px] h-[250px] bg-emerald-500/10 rounded-full blur-3xl pointer-events-none\"></div>\n<!-- SECTION 1: Mission and Vision -->\n<section class=\"relative animate-fade-up\" data-purpose=\"mission-vision-container\" id=\"vision-mission\">\n<div class=\"text-center max-w-2xl mx-auto mb-7 sm:mb-8\">\n\n<h2 class=\"text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight\">\n        Built on Mission. Driven by Purpose.\n      </h2>\n</div>\n<!-- 2-Column Split Cards -->\n<div class=\"grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6\">\n<!-- Card 1: Our Mission -->\n<div class=\"glass-emerald-card rounded-2xl p-6 sm:p-7 relative overflow-hidden flex flex-col justify-between smooth-hover animate-fade-up delay-100\" data-purpose=\"mission-card\">\n<div class=\"absolute -right-12 -top-12 w-48 h-48 bg-yellow-500/10 rounded-full blur-2xl pointer-events-none\"></div>\n<div>\n<span class=\"text-yellow-400 font-mono text-xs tracking-widest uppercase font-semibold\">01 / The Mission</span>\n<h3 class=\"text-xl sm:text-2xl font-bold text-white mt-1.5 mb-2.5 leading-snug\">\n            Democratize Master Coaching for Every Pincode in India.\n          </h3>\n<p class=\"text-slate-300 text-sm leading-relaxed mb-5 font-normal\">\n            For decades, top-tier IIT-JEE, NEET, and Olympiad ranks were confined to students from select coaching hubs who could afford exorbitant fees. Edu Rain demolishes this monopoly.\n          </p>\n<ul class=\"space-y-2.5 text-slate-300 text-xs sm:text-sm mb-6\">\n<li class=\"flex items-start gap-2.5\">\n<span class=\"text-yellow-400 font-bold shrink-0\">✓</span>\n<span><strong class=\"text-white\">Equity First:</strong> Premium live interactive classrooms at less than 1/10th traditional cost.</span>\n</li>\n<li class=\"flex items-start gap-2.5\">\n<span class=\"text-yellow-400 font-bold shrink-0\">✓</span>\n<span><strong class=\"text-white\">Zero Bandwidth Barrier:</strong> Proprietary lightweight streaming that runs on 3G speeds.</span>\n</li>\n<li class=\"flex items-start gap-2.5\">\n<span class=\"text-yellow-400 font-bold shrink-0\">✓</span>\n<span><strong class=\"text-white\">24/7 AI-Tutor:</strong> Real-time doubt clearance guaranteeing no student sleeps with queries.</span>\n</li>\n</ul>\n</div>\n\n</div>\n<!-- Card 2: Our Vision -->\n<div class=\"glass-emerald-card rounded-2xl p-6 sm:p-7 relative overflow-hidden flex flex-col justify-between smooth-hover animate-fade-up delay-200\" data-purpose=\"vision-card\">\n<div class=\"absolute -right-12 -bottom-12 w-48 h-48 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none\"></div>\n<div>\n<span class=\"text-emerald-400 font-mono text-xs tracking-widest uppercase font-semibold\">02 / The Vision</span>\n<h3 class=\"text-xl sm:text-2xl font-bold text-white mt-1.5 mb-2.5 leading-snug\">\n            To Build the World’s Most Intelligent &amp; Empathetic Learning Engine.\n          </h3>\n<p class=\"text-slate-300 text-sm leading-relaxed mb-5 font-normal\">\n            We envision a future where learning is an individualized evolutionary journey, blending heartfelt teacher empathy with neuroscience-backed cognitive algorithms.\n          </p>\n<ul class=\"space-y-2.5 text-slate-300 text-xs sm:text-sm mb-6\">\n<li class=\"flex items-start gap-2.5\">\n<span class=\"text-emerald-400 font-bold shrink-0\">✓</span>\n<span><strong class=\"text-white\">10 Million Leaders:</strong> Preparing exam toppers, critical thinkers, and scientific pioneers by 2030.</span>\n</li>\n<li class=\"flex items-start gap-2.5\">\n<span class=\"text-emerald-400 font-bold shrink-0\">✓</span>\n<span><strong class=\"text-white\">Adaptive Mastery:</strong> Real-time weakness diagnostics customizing test difficulties per student.</span>\n</li>\n<li class=\"flex items-start gap-2.5\">\n<span class=\"text-emerald-400 font-bold shrink-0\">✓</span>\n<span><strong class=\"text-white\">Holistic Support:</strong> Integrated stress-management coaches and mindset mentors embedded.</span>\n</li>\n</ul>\n</div>\n\n</div>\n</div>\n</section>\n<!-- Visual Connector -->\n<div class=\"flex items-center justify-center -my-6 sm:-my-8 transition-opacity duration-500\">\n<div class=\"h-6 w-px bg-gradient-to-b from-emerald-500/20 via-emerald-400/60 to-emerald-500/20\"></div>\n</div>\n<!-- SECTION 3: Key Metrics Strip -->\n<section class=\"relative animate-fade-up\" data-purpose=\"metrics-banner\" id=\"metrics\">\n<div class=\"glass-emerald-card rounded-2xl p-5 sm:p-7 border border-emerald-500/25 relative overflow-hidden smooth-hover\">\n<div class=\"grid grid-cols-2 md:grid-cols-4 gap-5 sm:gap-6 text-center divide-y md:divide-y-0 md:divide-x divide-emerald-900/60\">\n<div class=\"pt-2 md:pt-0\" data-purpose=\"metric-item\">\n<div class=\"text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-gradient-gold counter-value\" data-target=\"14.8\" data-suffix=\"M+\" data-decimals=\"1\">0</div>\n<div class=\"mt-1 text-xs sm:text-sm font-semibold uppercase tracking-wider text-white\">Active Learners</div>\n<p class=\"text-[11px] sm:text-xs text-slate-400 mt-0.5\">Across 740+ Indian Districts</p>\n</div>\n<div class=\"pt-2 md:pt-0\" data-purpose=\"metric-item\">\n<div class=\"text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-gradient-emerald counter-value\" data-target=\"8400\" data-suffix=\"+\" data-decimals=\"0\" data-comma=\"true\">0</div>\n<div class=\"mt-1 text-xs sm:text-sm font-semibold uppercase tracking-wider text-white\">IIT / NEET Qualifiers</div>\n<p class=\"text-[11px] sm:text-xs text-slate-400 mt-0.5\">Class of 2023 - 2024</p>\n</div>\n<div class=\"pt-2 md:pt-0\" data-purpose=\"metric-item\">\n<div class=\"text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-yellow-400 counter-value\" data-target=\"99.4\" data-suffix=\"%\" data-decimals=\"1\">0</div>\n<div class=\"mt-1 text-xs sm:text-sm font-semibold uppercase tracking-wider text-white\">Doubt Resolution</div>\n<p class=\"text-[11px] sm:text-xs text-slate-400 mt-0.5\">Median Response Time &lt; 4 mins</p>\n</div>\n<div class=\"pt-2 md:pt-0\" data-purpose=\"metric-item\">\n<div class=\"text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-emerald-400 counter-value\" data-target=\"4.9\" data-suffix=\" / 5\" data-decimals=\"1\">0</div>\n<div class=\"mt-1 text-xs sm:text-sm font-semibold uppercase tracking-wider text-white\">Parent Trust Index</div>\n<p class=\"text-[11px] sm:text-xs text-slate-400 mt-0.5\">Over 2.2M Verified Reviews</p>\n</div>\n</div>\n</div>\n</section>\n<!-- Visual Connector -->\n<div class=\"flex items-center justify-center -my-6 sm:-my-8 transition-opacity duration-500\">\n<div class=\"h-6 w-px bg-gradient-to-b from-emerald-500/20 via-emerald-400/60 to-emerald-500/20\"></div>\n</div>\n<!-- SECTION 4: Meet Our Founders -->\n<section class=\"relative animate-fade-up\" data-purpose=\"founders-leadership\" id=\"founders\">\n<div class=\"flex flex-col md:flex-row md:items-end justify-between mb-6 sm:mb-8 gap-3\">\n<div>\n<div class=\"text-xs font-mono uppercase tracking-widest text-yellow-400 font-semibold mb-1\">\n          Architects of the Vision\n        </div>\n<h2 class=\"text-2xl sm:text-3xl font-extrabold text-white tracking-tight\">Meet Our Founders</h2>\n</div>\n\n</div>\n<!-- Founders Grid -->\n<div class=\"grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6\">\n<!-- Founder 1: Dr. Vikramaditya Sharma -->\n<article class=\"glass-emerald-card rounded-2xl p-6 sm:p-7 flex flex-col justify-between relative group smooth-hover animate-fade-up delay-100\" data-purpose=\"founder-card-1\">\n<div>\n<div class=\"flex flex-col sm:flex-row items-center sm:items-start gap-4 sm:gap-5\">\n<div class=\"relat